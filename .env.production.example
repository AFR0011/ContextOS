# Copy to .env.production and replace every placeholder before deployment.
# Use URL-safe characters for POSTGRES_PASSWORD because Compose interpolates it into DATABASE_URL.
POSTGRES_USER=contextos
POSTGRES_PASSWORD=replace-with-url-safe-database-password
POSTGRES_DB=contextos

# Canonical public origin. Use the exact HTTPS origin in real deployments.
APP_URL=https://contextos.example.com
CONTEXTOS_PORT=3000

# Generate a fresh high-entropy value of at least 32 characters.
AUTH_SECRET=replace-with-at-least-32-random-characters

# Safe production defaults.
ALLOW_PUBLIC_REGISTRATION=false
ALLOW_DEMO_RESET=false

# Optional application-level throttling overrides.
# AUTH_RATE_LIMIT_WINDOW_MS=60000
# AUTH_LOGIN_MAX_FAILURES=8
# AUTH_REGISTER_MAX_ATTEMPTS=5

# Optional ContextOS -> SocialOS bridge. Leave unset when unused.
# CONTEXTOS_SSO_SECRET=
# SOCIALOS_APP_URL=https://socialos.example.com

# Optional browser-visible LifeOS module entry points.
# Accept root-relative ContextOS routes or absolute http(s) URLs. Leave unset to show Not connected.
# NEXT_PUBLIC_LIFEOS_RAVEL_URL=https://ravel.example.com
# NEXT_PUBLIC_LIFEOS_SOCIALOS_URL=https://socialos.example.com
# NEXT_PUBLIC_LIFEOS_LEDGER_URL=https://ledger.example.com
# NEXT_PUBLIC_LIFEOS_CANON_URL=https://canon.example.com
