generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions      Session[]
  areas         Area[]
  projects      Project[]
  tasks         Task[]
  dates         ContextDate[]
  dailyNotes    DailyNote[]
  syncMutations SyncMutation[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Area {
  id        String   @id
  userId    String
  name      String
  state     String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, state])
}

model Project {
  id        String   @id
  userId    String
  name      String
  areaId    String
  objective String   @default("")
  state     String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, areaId])
  @@index([userId, state])
  @@index([userId, updatedAt])
}

model Task {
  id            String    @id
  userId        String
  title         String
  plannedDate   DateTime?
  scheduledTime String?
  projectId     String?
  areaId        String?
  state         String    @default("open")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, state])
  @@index([userId, plannedDate])
  @@index([userId, projectId])
  @@index([userId, areaId])
}

model ContextDate {
  id        String   @id
  userId    String
  title     String
  kind      String
  date      DateTime
  startTime String?
  endTime   String?
  details   String   @default("")
  projectId String?
  areaId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
  @@index([userId, projectId])
  @@index([userId, areaId])
}

model DailyNote {
  id        String   @id
  userId    String
  localDate String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localDate])
  @@index([userId])
}

model SyncMutation {
  id         String    @id @default(cuid())
  mutationId String
  userId     String
  entityType String
  entityId   String
  operation  String
  payload    Json
  createdAt  DateTime  @default(now())
  appliedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, entityType])
  @@unique([userId, mutationId])
}
