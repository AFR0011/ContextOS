generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions      Session[]
  domains       Domain[]
  projects      Project[]
  tasks         Task[]
  captures      Capture[]
  notes         Note[]
  deadlines     Deadline[]
  reviews       Review[]
  priorities            Priority[]
  dashboardScratchpads  DashboardScratchpad[]
  dashboardPreferences  DashboardPreference[]
  syncMutations         SyncMutation[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Domain {
  id        String   @id
  userId    String
  name      String
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, archived])
}

model Project {
  id               String    @id
  userId           String
  name             String
  domainId         String
  parentProjectId  String?
  status           String    @default("active")
  currentObjective String    @default("")
  nextAction       String    @default("")
  latestStatus     String    @default("")
  recoveryNotes    String    @default("")
  openLoops        String[]  @default([])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  archivedAt       DateTime?
  trashedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, parentProjectId])
  @@index([userId, status])
  @@index([userId, updatedAt])
}

model Task {
  id          String    @id
  userId      String
  title       String
  plannedDate DateTime?
  dueDate     DateTime?
  startTime   String?
  endTime     String?
  projectId   String?
  domainId    String?
  status      String    @default("todo")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?
  trashedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([userId, plannedDate])
  @@index([userId, dueDate])
}

model Capture {
  id            String   @id
  userId        String
  text          String
  status        String   @default("unprocessed")
  type          String?
  parsedData    Json?
  convertedToId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([userId, createdAt])
}

model Note {
  id         String    @id
  userId     String
  title      String
  content    String    @default("")
  projectId  String?
  domainId   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  trashedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, projectId])
}

model Deadline {
  id         String    @id
  userId     String
  title      String
  date       DateTime
  time       String?
  location   String    @default("")
  projectId  String?
  taskIds    String[]  @default([])
  notes      String    @default("")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  trashedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
}

model Review {
  id        String   @id
  userId    String
  type      String
  date      DateTime
  responses Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
  @@index([userId, date])
}

model Priority {
  id        String   @id
  userId    String
  scope     String
  dateKey   String
  text      String
  taskId    String?
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, scope, dateKey])
}

model DashboardScratchpad {
  id        String   @id
  userId    String   @unique
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DashboardPreference {
  id                String   @id
  userId            String   @unique
  sectionOrder      String[] @default([])
  collapsedSections String[] @default([])
  reviewPromptDismissals String[] @default([])
  dateWindowDays    Int      @default(14)
  showCompleted     Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SyncMutation {
  id         String    @id @default(cuid())
  mutationId String    @unique
  userId     String
  entityType String
  entityId   String
  operation  String
  payload    Json
  createdAt  DateTime  @default(now())
  appliedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, entityType])
}
